# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Secrets ------------------------------------------------------------
# Both required: paperless refuses to start without a secret key.
#   POSTGRES_PASSWORD:     openssl rand -base64 32
#   PAPERLESS_SECRET_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
POSTGRES_PASSWORD=
PAPERLESS_SECRET_KEY=

# --- LLM backend --------------------------------------------------------
# claude | ollama | off  -- selects ai/<value>.env
AI_BACKEND=claude

# Anthropic API key when AI_BACKEND=claude. Leave empty otherwise.
AI_API_KEY=

# --- Access -------------------------------------------------------------
# No trailing path. Set this to the real hostname behind the VPN, or CSRF
# rejects logins from anything but localhost.
PAPERLESS_URL=http://localhost:8000
PAPERLESS_PORT=8000
PAPERLESS_TIME_ZONE=Europe/Berlin

# First superuser, created on first start only. Clear both afterwards --
# they otherwise sit in the environment of a running container.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# --- Storage ------------------------------------------------------------
# In production these point at the ZFS mirror, which is what replaces the
# old application-level dual-copy write (see ADR 0006).
#   PAPERLESS_MEDIA_PATH   originals, PDF/A archive versions, thumbnails
#   PAPERLESS_DATA_PATH    search index, embedding index, classifier model
#   PAPERLESS_CONSUME_PATH watchfolder -- point the scanner share here
#   PAPERLESS_EXPORT_PATH  document_exporter output, picked up by backup
PAPERLESS_MEDIA_PATH=./media
PAPERLESS_DATA_PATH=./data
PAPERLESS_CONSUME_PATH=./consume
PAPERLESS_EXPORT_PATH=./export

# 0 = inotify. Set to a value in seconds (e.g. 30) when the consume
# directory is an SMB/NFS share, where inotify does not fire.
PAPERLESS_CONSUMER_POLLING_INTERVAL=0

# Must match the owner of the paths above, or ingest fails on permissions.
USERMAP_UID=1000
USERMAP_GID=1000

# --- Backup -------------------------------------------------------------
# Required by the backup container.
#   BACKUP_ENCRYPTION_KEY: openssl rand -base64 32
# Losing this key makes every encrypted artifact unrecoverable -- store it
# somewhere that is NOT only on this machine.
BACKUP_ENCRYPTION_KEY=

# Second local copy. Must be a different physical disk than the media path.
BACKUP_REPLICA_HOST_PATH=./backup-replica
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Third copy, offsite. Empty runs backups locally only; set
# REQUIRE_OFFSITE_BACKUP=true to make a missing remote a hard failure.
RCLONE_REMOTE=
REQUIRE_OFFSITE_BACKUP=false
RCLONE_CONFIG_HOST_PATH=./backup/rclone.conf.example

# Restore drill: how often, and how many originals to hash-check.
RESTORE_VERIFY_INTERVAL_SECONDS=604800
RESTORE_SAMPLE_SIZE=25

# Failure alerts. Empty leaves failures in the container log only.
SMTP_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
BACKUP_ALERT_EMAIL_TO=
BACKUP_ALERT_EMAIL_FROM=
