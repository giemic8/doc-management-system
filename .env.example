POSTGRES_DB=dms_db
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=dms_secret_password
JWT_SECRET=super_secret_jwt_key_change_in_prod
MFA_ENCRYPTION_KEY=change_this_mfa_encryption_key_in_prod
STORAGE_ENCRYPTION_KEY=change_this_storage_encryption_key_in_prod
STORAGE_ENCRYPTION_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=

# Backup and restore verification. Use unique production secrets and mount
# BACKUP_REPLICA_HOST_PATH on another physical disk.
BACKUP_ENCRYPTION_KEY=change_this_backup_encryption_key_in_prod
BACKUP_REPLICA_HOST_PATH=./backup-replica
BACKUP_RETENTION_DAYS=30
RCLONE_CONFIG_HOST_PATH=./backup/rclone.conf.example
RCLONE_REMOTE=
REQUIRE_OFFSITE_BACKUP=false
RESTORE_VERIFY_INTERVAL_SECONDS=604800
RESTORE_SAMPLE_SIZE=25

# SMTP failure alerts. Credentials stay in local .env or secret manager.
SMTP_URL=
SMTP_USERNAME=
SMTP_PASSWORD=
BACKUP_ALERT_EMAIL_TO=
BACKUP_ALERT_EMAIL_FROM=
