# Dependencies
node_modules/
__pycache__/
.pytest_cache/
*.pyc
.venv/
env/

# Build outputs
dist/
build/
.vite/

# Environment files
.env
.env.local

# Backup service: real rclone credentials (see backup/rclone.conf.example)
backup/rclone.conf

# Storage (keep folder structure with gitkeep)
storage/originals/*
!storage/originals/.gitkeep
storage/derived/*
!storage/derived/.gitkeep
storage/thumbnails/*
!storage/thumbnails/.gitkeep
storage/input/*
!storage/input/.gitkeep

# Ticket #31 — second independent copy of durable originals, created at
# runtime by StorageService.initStorageDirectories(). Local dev default
# mount; not source content.
storage-replica/
backup-replica/

# System & IDE
.DS_Store
*.log
.vscode/
.idea/
.envrc
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.github/copilot-instructions.md
.github/copilot/plans/*.md
.github/git-commit-instructions.md
.github/instructions/*.instructions.md
.github/prompts/*.prompt.md
.github/skills/*.md
/.mcp.json

# openpackage source cache: full external repo clones (own .git dirs),
# never real submodules (no .gitmodules) -- local cache only.
.openpackage/source-cache/
