data/
media/
consume/
export/
backup-replica/

# System & IDE
.DS_Store
*.log
.vscode/
.idea/
.envrc
/.mcp.json

# Agent tooling caches
.github/copilot-instructions.md
.github/copilot/plans/*.md
.github/git-commit-instructions.md
.github/instructions/*.instructions.md
.github/prompts/*.prompt.md
.github/skills/*.md
.openpackage/source-cache/
