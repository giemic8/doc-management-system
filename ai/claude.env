# Claude via Anthropic's OpenAI-compatible endpoint.
# Selected with AI_BACKEND=claude (the default).
#
# No adapter and no third-party analyzer: paperless-ngx 3.x speaks to any
# OpenAI-compatible API directly, and Anthropic serves one.
#
# The API key is NOT here. It comes from AI_API_KEY in .env, which is
# gitignored -- see README.md.

PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT=https://api.anthropic.com/v1/
PAPERLESS_AI_LLM_MODEL=claude-opus-5
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=de
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=120

# Anthropic publishes no embeddings endpoint, so retrieval embeddings run
# locally on CPU. Identical in ai/ollama.env on purpose: switching the
# generation backend then does not invalidate the embedding index, which
# would otherwise need a full rebuild on every switch.
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface
PAPERLESS_AI_LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE=1024
