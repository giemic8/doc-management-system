# Local Ollama. Selected with AI_BACKEND=ollama, and requires the ollama
# service:  docker compose --profile ollama up -d
#
# Nothing leaves the machine. This is the option that satisfies the
# "EU processing" requirement the old roadmap recorded for remote AI,
# at the cost of noticeably weaker extraction on German post.
#
# Pull the model once after first start:
#   docker compose exec ollama ollama pull llama3.1

PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_BACKEND=ollama
PAPERLESS_AI_LLM_ENDPOINT=http://ollama:11434
PAPERLESS_AI_LLM_MODEL=llama3.1
PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=de
PAPERLESS_AI_LLM_CONTEXT_SIZE=8192
# Local inference on CPU is slow; a tight timeout looks like a broken
# feature rather than a slow one.
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300

# Kept identical to ai/claude.env -- see the note there.
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface
PAPERLESS_AI_LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERLESS_AI_LLM_EMBEDDING_CHUNK_SIZE=1024
